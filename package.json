{
  "name": "zt-exam",
  "version": "1.0.0",
  "description": "Zero-Trust LAN Exam System (Host & Student Kiosk)",
  "main": "./out/main/index.js",
  "author": "ZT-Exam Team",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev -- --profile=host --role=host",
    "dev:host": "electron-vite dev -- --profile=host --role=host",
    "dev:student": "electron-vite dev -- --profile=student-1 --role=student --windowed-kiosk",
    "dev:pair": "concurrently -k -n host,student -c blue,green \"npm run dev:host\" \"npm run dev:student\"",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs",
    "keys:generate": "node scripts/keygen.ts",
    "build:native": "node-gyp rebuild --directory=native",
    "roster:entry": "node scripts/provision-device.ts",
    "roster:sign": "node scripts/sign-device-roster.ts",
    "manifest:sign": "node scripts/sign-manifest.ts --root resources-unpacked",
    "manifest:verify": "node scripts/sign-manifest.ts --root resources-unpacked --verify",
    "fuses:apply": "node scripts/apply-fuses.ts",
    "package:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.62.0",
    "monaco-editor": "^0.57.0",
    "node-addon-api": "^8.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "selfsigned": "^5.5.0",
    "sonner": "^2.0.8",
    "systeminformation": "^5.33.16",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
